{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laix.dev/contracts/decision.v1.schema.json",
  "title": "LAIX Decision v1",
  "description": "The canonical output of a LAIX policy. An app supplies signals or a situation; the policy returns one Decision per candidate, plus optional receipts, outcomes and a decision record.",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "default": "reference" },
        "quote": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "start": { "type": "number" },
        "end": { "type": "number" }
      },
      "additionalProperties": false
    },
    "Intent": {
      "type": "object",
      "required": ["capability"],
      "description": "A named capability with typed arguments. LAIX carries it; the platform executes it.",
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "args": { "type": "object", "default": {} }
      },
      "additionalProperties": false
    },
    "Escalation": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },
    "Breakdown": {
      "type": "object",
      "description": "How a policy-specific score was reached. Each policy keeps its own score and breakdown.",
      "properties": {
        "severity": { "type": "number" },
        "due": { "type": "number" },
        "confidence": { "type": "number" },
        "interruption": { "type": "number" },
        "learned": { "type": "number" },
        "total": { "type": "number" }
      },
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "required": ["verb", "confidence", "reason_code", "rationale"],
      "properties": {
        "decision_id": { "type": "string" },
        "policy_version": { "type": "string" },
        "verb": {
          "enum": ["wait", "observe", "guide", "ask", "act", "verify", "escalate"]
        },
        "action_id": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason_code": {
          "type": "string",
          "description": "A stable machine-readable reason. Policy-specific values are allowed; the documented values are notify, guide, kill_switch, muted, snoozed, wrong, assigned, dismissed, low_confidence, below_floor, already_sent, quiet_hours, budget, overdue_escalation, act, ask_approval, policy_rule, no_admissible_option."
        },
        "rationale": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRef" } },
        "requires_approval": { "type": "boolean", "default": false },
        "score": { "type": ["number", "null"] },
        "breakdown": { "anyOf": [{ "$ref": "#/$defs/Breakdown" }, { "type": "null" }] },
        "intent": { "anyOf": [{ "$ref": "#/$defs/Intent" }, { "type": "null" }] },
        "escalation": { "anyOf": [{ "$ref": "#/$defs/Escalation" }, { "type": "null" }] },
        "cost_of_waiting": { "type": "number", "default": 0 },
        "reversible": { "type": "boolean", "default": false },
        "undo_hint": { "enum": ["withdraw", "cancel", null] },
        "trace_id": { "type": "string" },
        "deliver": { "type": "boolean", "default": true },
        "record": { "type": "boolean", "default": true },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "required": ["receipt_id", "decision_id", "status", "actor"],
      "properties": {
        "receipt_id": { "type": "string" },
        "decision_id": { "type": "string" },
        "action_name": { "type": "string" },
        "status": {
          "enum": ["pending", "approved", "executed", "refused", "cancelled", "failed", "undone"]
        },
        "actor": { "type": "string" },
        "approved_by": { "type": ["string", "null"] },
        "at": { "type": "string", "format": "date-time" },
        "detail": { "type": "object" },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Outcome": {
      "type": "object",
      "required": ["decision_id", "metric", "label"],
      "properties": {
        "outcome_id": { "type": "string" },
        "decision_id": { "type": "string" },
        "metric": { "type": "string" },
        "before": { "type": "number" },
        "after": { "type": "number" },
        "delta": { "type": "number" },
        "direction": { "enum": ["higher-better", "lower-better"] },
        "label": { "enum": ["helped", "neutral", "hurt", "unknown"] },
        "reason_code": { "type": ["string", "null"] },
        "attributed": { "type": "boolean", "default": false },
        "evidence": { "type": "object" },
        "measured_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "required": ["required", "state"],
      "properties": {
        "required": { "type": "boolean" },
        "state": { "enum": ["pending", "approved", "rejected"] },
        "by": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Undo": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "how": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "AuditEvent": {
      "type": "object",
      "required": ["at", "actor", "action"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string" },
        "action": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DecisionRecord": {
      "type": "object",
      "required": ["id", "status", "title", "decision", "evidence", "approval", "created_at", "updated_at", "audit", "undo", "hash"],
      "properties": {
        "id": { "type": "string" },
        "version": { "const": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "decision": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "rationale": { "type": "string" }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/EvidenceRef" }
        },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "approval": { "$ref": "#/$defs/Approval" },
        "status": { "enum": ["draft", "approved", "rejected", "executed", "undone"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "audit": { "type": "array", "items": { "$ref": "#/$defs/AuditEvent" } },
        "undo": { "$ref": "#/$defs/Undo" },
        "metadata": { "type": "object" },
        "hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Signal": {
      "type": "object",
      "required": ["id", "kind", "severity", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "due": { "type": ["string", "null"], "format": "date-time" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "group_key": { "type": ["string", "null"] },
        "interruption_cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "requires_approval": { "type": "boolean" },
        "intent": { "anyOf": [{ "$ref": "#/$defs/Intent" }, { "type": "null" }] },
        "reversible": { "type": "boolean" },
        "escalation": { "anyOf": [{ "$ref": "#/$defs/Escalation" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "required": ["now"],
      "properties": {
        "now": { "type": "string", "format": "date-time" },
        "quiet_hours": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
            { "type": "null" }
          ]
        },
        "stopped": { "type": "boolean", "default": false },
        "min_severity": { "enum": ["critical", "high", "medium", "low", "info"], "default": "high" },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "muted_kinds": { "type": "array", "items": { "type": "string" } },
        "interruption_budget": { "type": ["integer", "null"], "minimum": 0 },
        "sent": { "type": "array", "items": { "type": "string" } },
        "feedback": { "type": "object" },
        "escalate_after_hours": { "type": ["number", "null"] },
        "learned": { "type": "object", "additionalProperties": { "type": "number" } },
        "allow_act": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "Situation": {
      "type": "object",
      "required": ["id", "at", "subject"],
      "properties": {
        "id": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "subject": { "type": "string" },
        "observations": { "type": "array", "items": { "type": "object" } },
        "beliefs": { "type": "array", "items": { "type": "object" } },
        "goals": { "type": "array", "items": { "type": "object" } },
        "constraints": { "type": "array", "items": { "type": "object" } },
        "phase": { "enum": ["observe", "understand", "decide", "act", "verify", "adapt"] },
        "horizon": { "enum": ["seconds", "minutes", "hours", "days", "weeks"] },
        "attributes": { "type": "object" }
      },
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "required": ["id", "verb", "name"],
      "properties": {
        "id": { "type": "string" },
        "verb": { "enum": ["wait", "observe", "guide", "ask", "act", "verify", "escalate"] },
        "name": { "type": "string" },
        "params": { "type": "object" },
        "expected_benefit": { "type": "number", "minimum": 0, "maximum": 1 },
        "cost": { "type": "number" },
        "risk": { "type": "number", "minimum": 0, "maximum": 1 },
        "latency_ms": { "type": "integer" },
        "interrupt_cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "destructive": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "requires_approval": { "type": "boolean" },
        "addresses": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Decision"
}
